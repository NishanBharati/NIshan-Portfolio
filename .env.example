# Copy this file to `.env` and fill in the values from
# Supabase Dashboard -> Project Settings -> API (or "Connect").

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The public "anon" key (or the newer "publishable" key, sb_publishable_...).
# It is safe to ship to the browser: Row Level Security in supabase/schema.sql protects the data.
# NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=
